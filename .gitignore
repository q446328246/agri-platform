# Ed25519 密钥对（和风 JWT）：私钥绝不能入库
*.pem
# MQTT 本地 CA/服务端证书与私钥由 scripts/init-mqtt-certs.mjs 在本机生成
infra/emqx/certs/*
coverage/
.tmp/
# 备份产物：由 scripts/backup-system.mjs 写入，不入库
backups/
# PowerShell 模块分析缓存：pwsh 运行可能把它误落在工作目录
Microsoft/Windows/PowerShell/ModuleAnalysisCache

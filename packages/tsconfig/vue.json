{
  "$schema": "https://json.schemastore.org/tsconfig",
  "display": "AGRI Vue Frontend",
  "extends": "./base.json",
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "preserve",
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "types": []
  }
}

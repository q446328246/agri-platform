NODE_ENV=development
DB_URL=postgresql://agri:agri@127.0.0.1:5432/agri
DB_SHARD_MODE=single
DB_POOL_SIZE=10
DB_SLOW_QUERY_MS=500
MQ_BROKERS=127.0.0.1:9092
MQ_GROUP_ID=agri-platform
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_DB=0

PLOT_REPOSITORY_MODE=sql
AUTH_REPOSITORY_MODE=sql
PLATFORM_REPOSITORY_MODE=sql

# 登录会话：有效期（秒）与滑动续期；接数据库时会话写入 auth_sessions，重启后 token 仍有效
AUTH_SESSION_TTL_SECONDS=7200

# 事件闭环：遥测越限事件开关与消息消费参数
TELEMETRY_PUBLISH_EVENTS=true
MESSAGE_REPOSITORY_MODE=sql
MESSAGE_CONSUMER_GROUP=message-service
MESSAGE_POLL_INTERVAL_MS=1000

# 事件消费方：控制指令与生产档案
CONTROL_REPOSITORY_MODE=sql
CONTROL_CONSUMER_GROUP=control-service
CONTROL_POLL_INTERVAL_MS=1000
TRACE_REPOSITORY_MODE=sql
TRACE_CONSUMER_GROUP=trace-service
TRACE_POLL_INTERVAL_MS=1000
FILE_STORAGE_MODE=s3
FILE_S3_ENDPOINT=http://127.0.0.1:9000
FILE_S3_BUCKET=agri
FILE_S3_REGION=us-east-1
FILE_S3_ACCESS_KEY=minioadmin
FILE_S3_SECRET_KEY=minioadmin

# 权限校验：网关始终强制鉴权，服务侧守卫默认关闭（本地直连脚本不带身份头）
# 部署环境把 AUTH_GUARD_MODE 置为 enforce，服务也会按 x-user-id / x-permissions 再判一次
GATEWAY_AUTH_ENABLED=true
GATEWAY_AUTH_CACHE_MS=5000
GATEWAY_ROLE_CACHE_MS=10000
INTERNAL_TOKEN=agri-internal
# AUTH_GUARD_MODE=enforce

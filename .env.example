NODE_ENV=development
DB_URL=postgresql://agri:agri@127.0.0.1:5432/agri
DB_SHARD_MODE=single
DB_POOL_SIZE=10
DB_SLOW_QUERY_MS=500
MQ_BROKERS=127.0.0.1:9092
MQ_GROUP_ID=agri-platform
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_DB=0

PLOT_REPOSITORY_MODE=sql
AUTH_REPOSITORY_MODE=sql
PLATFORM_REPOSITORY_MODE=sql

# 登录会话：有效期（秒）与滑动续期；接数据库时会话写入 auth_sessions，重启后 token 仍有效
AUTH_SESSION_TTL_SECONDS=7200

# 事件闭环：遥测越限事件开关与消息消费参数
TELEMETRY_PUBLISH_EVENTS=true
MESSAGE_REPOSITORY_MODE=sql
MESSAGE_CONSUMER_GROUP=message-service
MESSAGE_POLL_INTERVAL_MS=1000

# 事件消费方：控制指令与生产档案
CONTROL_REPOSITORY_MODE=sql
CONTROL_CONSUMER_GROUP=control-service
CONTROL_POLL_INTERVAL_MS=1000
# 控制指令在途超过该分钟数未收到回执：列表按「超时未回执」标记，定时任务据此收口为 FAILED 并推事件
CONTROL_RECEIPT_TIMEOUT_MIN=15
# 超时收口扫描间隔（毫秒，最小 1000）与单轮最多收口条数
CONTROL_RECEIPT_SWEEP_INTERVAL_MS=60000
# control_outbox 待投递事件的中继间隔（毫秒）
CONTROL_OUTBOX_RELAY_INTERVAL_MS=1000
TRACE_REPOSITORY_MODE=sql
TRACE_CONSUMER_GROUP=trace-service
TRACE_POLL_INTERVAL_MS=1000
FILE_STORAGE_MODE=s3
FILE_S3_ENDPOINT=http://127.0.0.1:9000
FILE_S3_BUCKET=agri
FILE_S3_REGION=us-east-1
FILE_S3_ACCESS_KEY=minioadmin
FILE_S3_SECRET_KEY=minioadmin

# 权限校验：网关始终强制鉴权，服务侧守卫默认关闭（本地直连脚本不带身份头）
# 部署环境把 AUTH_GUARD_MODE 置为 enforce，服务也会按 x-user-id / x-permissions 再判一次
GATEWAY_AUTH_ENABLED=true
GATEWAY_AUTH_CACHE_MS=5000
GATEWAY_ROLE_CACHE_MS=10000
INTERNAL_TOKEN=agri-internal
# 设备/算法回调共享凭证：遥测上报、虫情回调、视频 AI 回调经网关或直连服务时携带 x-device-token。
# 网关与 telemetry/video 服务须配置同一值；留空则设备通道关闭，回调只能由有写权限的登录用户发起。
# 生产环境请用随机值（如 node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"）
DEVICE_CALLBACK_TOKEN=
# AUTH_GUARD_MODE=enforce

# 视频服务：DB_URL 存在且 VIDEO_REPOSITORY_MODE 非 memory 时，识别事件与云台指令落库（迁移 018），否则内存演示不持久
# VIDEO_REPOSITORY_MODE=sql
# 云台摄像机网关（国标平台/厂商服务）回调地址：配置后指令经其下发并按真实回执记 SENT/FAILED；留空则指令留存 QUEUED
# PTZ_WEBHOOK_URL=
# 识别事件转发失败后的自动补投间隔（毫秒）与上限（含首次转发）；超限后仍可人工重试
# VIDEO_AI_RETRY_INTERVAL_MS=30000
# VIDEO_AI_MAX_RETRIES=5

# 气象服务：WEATHER_REPOSITORY_MODE=sql 且 DB_URL 存在时读 weather_forecasts/hours/alerts 三张表，否则回退内存 demo 种子
WEATHER_REPOSITORY_MODE=sql
# 实时气象站读数从 telemetry-service 取最新值（留空则默认 http://127.0.0.1:3004）
# TELEMETRY_SERVICE_URL=http://127.0.0.1:3004

# 和风天气（QWeather）可选接入：不填 Key 则仅读本地仓储；填入后启动定时同步器将外部预报与预警落库
# 个人开发者免费额度约每日 1000 次；本默认 “每日一次” 节奏，一天最多消耗 2 次（forecast + alert）
# 前端接口仍仅读本地数据库，页面刷新不启外部请求；启动时自动判断上次刷新仍在周期内则不重复拉取
#
# 接口版本：
# - v1（默认）官方推荐，支持实时天气、每日预报、小时预报、天气预警，基于专属 API Host 与经纬度
#   登录 https://console.qweather.com/setting 获取形如 `h2a9cf3mhs.xy.qweatherapi.com` 专属 Host
# - v7（Deprecated）旧接口基于 LocationID，公共域名 devapi/api.qweather.com 将从 2026 年起逐步停用，仅保留给旧 Key 过渡
QWEATHER_API_VERSION=v1
# QWEATHER_HOST=                   # v1 必填专属 Host；缺 Host 或命中旧域名时同步器不启动，行为与零配置一致
# QWEATHER_LATITUDE=31.21          # v1 使用；默认达州市
# QWEATHER_LONGITUDE=107.50        # v1 使用
# QWEATHER_CITY=达州市
#
# 认证方式（v1 三选一，优先级 jwtSigner > jwt > key）：
# ① JWT 私钥签发（推荐，官方首选）：需 Ed25519 密钥对，公钥上传到控制台凭据，私钥本地签发
#    kid=凭据ID、iss=开发者ID(Q开头10位)、sub=项目ID，均可在控制台-项目管理/设置查看
# QWEATHER_KEY_ID=                 # JWT Header.kid 凭据 ID
# QWEATHER_DEVELOPER_ID=           # JWT Payload.iss 开发者 ID
# QWEATHER_PROJECT_ID=             # JWT Payload.sub 项目 ID
# QWEATHER_PRIVATE_KEY_PATH=/run/secrets/qweather-private.pem  # 私钥文件路径（容器内挂载点）
# QWEATHER_PRIVATE_KEY=            # 或直接内联 PEM 内容（与 PATH 二选一，内联优先）
# QWEATHER_JWT_TTL_SECONDS=900     # 令牌有效期秒数，默认 900（官方上限 86400）
# ② 静态 JWT（临时调试用，需自行定期换发）
# QWEATHER_JWT=                    # 完整 JWT 字符串，走 Authorization: Bearer
# ③ API Key（安全性较低，2027 起将限流）
# QWEATHER_KEY=
# v7 兼容参数（仅当 QWEATHER_API_VERSION=v7 时生效）
# QWEATHER_LOCATION_ID=101270600
# QWEATHER_TIMEOUT_MS=3000
# 日预报拉取天数，默认 7（今天起一周）；v1 上限 10 天，v7 超过 3 天走 7d 档
# QWEATHER_FORECAST_DAYS=7
# QWEATHER_FORECAST_REFRESH_MINUTES=1440
# QWEATHER_ALERT_REFRESH_MINUTES=1440
# QWEATHER_HOURLY_RETAIN_HOURS=72
# QWEATHER_DAILY_CALL_LIMIT=20
